    given-names: Alex
    affiliation: "Stanford Graduate School of Business"
    email: astorer@stanford.edu
repository-code: "https://github.com/gsbdarc/bay-area-smoke"
license: MIT
license-url: "https://github.com/gsbdarc/bay-area-smoke/blob/main/LICENSE-data"
keywords:
  - wildfire smoke
  - air quality
  - PM2.5
  - California
  - data visualization
