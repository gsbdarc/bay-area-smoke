# ---- Raw data: never committed, never edited in place ----
data/raw/

# ---- Intermediate panels: regenerable from raw, so version the recipe
# not the output. The one exception is the ECHOLab Bay Area subset, which
# is expensive to rebuild (1.8 GB download) and IS committed -- see issue #5.
data/processed/*.parquet

# ---- Secrets ----
.env
*.env
!.env.example

# ---- Python (github/gitignore Python.gitignore, trimmed) ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS ----
.DS_Store
Thumbs.db
